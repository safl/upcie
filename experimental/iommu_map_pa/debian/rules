#!/usr/bin/make -f
# DKMS source package for the experimental upcie iommu-map helper module.
#
# The module is not compiled at package-build time; DKMS builds it on the
# target against the running kernel. dh_dkms installs debian/*.dkms as the
# dkms.conf and wires up the maintainer scripts (dkms add/build/install).
#
# Only the module sources ship in the package; the userspace test in this
# directory builds from the upcie tree (its meson.build makes debhelper
# auto-detect meson), so every dh_auto_* step is neutralised to keep it out
# of the package build.
#
# Version is a single source of truth: the (native) upstream version from the
# changelog drives the module source path and the DKMS module version, so the
# deb version, /usr/src/upcie-iommu-map-<ver> tree, and dkms.conf
# PACKAGE_VERSION never drift.

export DH_VERBOSE = 1

VERSION := $(shell dpkg-parsechangelog -SVersion)
PACKAGE := upcie-iommu-map
DKMS_TREE := debian/$(PACKAGE)-dkms/usr/src/$(PACKAGE)-$(VERSION)

%:
	dh $@ --with dkms

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:

override_dh_install:
	install -d $(DKMS_TREE)
	install -m0644 module/upcie_iommu_map.c module/upcie_iommu_map.h module/Makefile $(DKMS_TREE)/
	# Install the UAPI header system-wide so consumers can build against the
	# map ioctls without vendoring: #include <upcie/upcie_iommu_map.h>
	# Not /usr/include/linux/: that path is owned by linux-libc-dev, and a
	# collision there would make this package fail to install.
	install -D -m0644 module/upcie_iommu_map.h debian/$(PACKAGE)-dkms/usr/include/upcie/upcie_iommu_map.h
	# The wrapper is the surface consumers actually call (upcie_iommu_map_open/
	# add/del); shipping only the ioctl ABI left them vendoring it by hand.
	install -D -m0644 include/upcie/iommu_map.h debian/$(PACKAGE)-dkms/usr/include/upcie/iommu_map.h

override_dh_dkms:
	dh_dkms -V $(VERSION)
