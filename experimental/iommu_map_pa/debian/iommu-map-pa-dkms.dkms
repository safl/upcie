# PACKAGE_VERSION is substituted by dh_dkms from the packaging version
# (dh_dkms -V), so it always matches the /usr/src/iommu-map-pa-<ver> tree.
PACKAGE_NAME="iommu-map-pa"
PACKAGE_VERSION="#MODULE_VERSION#"
AUTOINSTALL="yes"

BUILT_MODULE_NAME[0]="iommu_map_pa"
DEST_MODULE_LOCATION[0]="/updates"

MAKE[0]="make KDIR=${kernel_source_dir}"
