#!/usr/bin/make -f
# DKMS source package for the out-of-tree udmabuf dma-buf importer.
#
# The module is not compiled at package-build time; DKMS builds it on the
# target against the running kernel. dh_dkms installs debian/*.dkms as the
# dkms.conf and wires up the maintainer scripts (dkms add/build/install).
#
# The repo-root Makefile builds the userspace *examples*, not the module, so
# the dh_auto_* steps are neutralised to keep them out of the package build.
#
# Version is a single source of truth: the (native) upstream version from the
# changelog drives the module source path and the DKMS module version, so the
# deb version, /usr/src/udmabuf-import-<ver> tree, and dkms.conf PACKAGE_VERSION
# never drift. CI stamps that version from git; see .github/workflows.

export DH_VERBOSE = 1

VERSION := $(shell dpkg-parsechangelog -SVersion)
PACKAGE := udmabuf-import
DKMS_TREE := debian/$(PACKAGE)-dkms/usr/src/$(PACKAGE)-$(VERSION)

%:
	dh $@ --with dkms

override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

override_dh_install:
	install -d $(DKMS_TREE)
	install -m0644 module/udmabuf_import.c module/udmabuf_import.h module/Makefile $(DKMS_TREE)/
	# Install the UAPI header system-wide so consumers can build against the
	# import ioctls without vendoring: #include <linux/udmabuf_import.h>
	install -D -m0644 module/udmabuf_import.h debian/$(PACKAGE)-dkms/usr/include/linux/udmabuf_import.h

override_dh_dkms:
	dh_dkms -V $(VERSION)
